{
    "permissions": {
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.development)",
            "Read(**/.env.production)",
            "Bash(cat **/.env)",
            "Bash(cat **/.env.local)",
            "Bash(cat **/.env.production)",
            "Bash(cat .env)",
            "Bash(cat .env.local)",
            "Bash(cat .env.production)"
        ]
    }
}
